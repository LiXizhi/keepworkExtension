# The macOS VS Code task launcher is executed by /bin/zsh.
/scripts/vscode-pnpm-task.zsh text eol=lf
# Runtime manifest hashes cover exact generated bytes, including line endings.
/src/core/vendor/aichat-runtime/*.cjs text eol=lf
/src/core/vendor/aichat-runtime/manifest.json text eol=lf
# Preserve upstream WinPTY bytes covered by pinned SHA-256 values.
/apps/mcp-rust/vendor/winpty-0.4.3/** -text
# Keep the pinned upstream Popover script, license and provenance unchanged.
/apps/aichat-rust/windows/cef-host/vendor/** -text
