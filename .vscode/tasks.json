{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "keepwork VS code extension:Run",
      "type": "shell",
      "command": "code",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "dependsOn": "VS Code Extension: Build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "npm run compile:only",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": "$tsc",
      "label": "VS Code Extension: Build",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": [],
      "label": "VS Code Extension: Watch",
      "isBackground": true,
      "group": "build"
    },
    {
      "type": "shell",
      "command": "npm run package",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": [],
      "label": "VS Code Extension: Package VSIX",
      "group": "build"
    },
    {
      "type": "shell",
      "label": "Keepwork: Publish Latest VSIX (Entra)",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$candidate = Get-ChildItem -LiteralPath '${workspaceFolder}/apps/vscode-extension' -File -Filter 'keepwork-*.vsix' | ForEach-Object { if ($_.BaseName -match '^keepwork-(\\d+\\.\\d+\\.\\d+)$') { [PSCustomObject]@{ File = $_; Version = [version]$Matches[1] } } } | Sort-Object Version -Descending | Select-Object -First 1; if (-not $candidate) { throw 'No keepwork-X.Y.Z.vsix package found in apps/vscode-extension.' }; Write-Host \"Publishing $($candidate.File.Name)...\"; $env:PATH = 'C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin;' + $env:PATH; & '${workspaceFolder}/apps/vscode-extension/node_modules/.bin/vsce.cmd' publish --azure-credential --packagePath $candidate.File.FullName; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "shell",
      "command": "npm run dev:server",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": [],
      "label": "Keepwork MCP: Dev Server (8089)",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "KeepWork 第二大脑: Start",
      "type": "shell",
      "command": "npm",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/aichat-desktop",
        "env": {
          "AICHAT_DESKTOP_LOCAL_SOURCE": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "KeepWork 第二大脑: Build",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/aichat-desktop"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
