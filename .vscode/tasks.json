{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Keepwork MCP: Build",
      "detail": "Build the standalone MCP server and bundled skills locally; does not publish or change versions.",
      "type": "shell",
      "command": "npm",
      "args": ["run", "build", "--prefix", "apps/mcp-runtime"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Keepwork MCP: Build & Publish Stable (GitHub Actions)",
      "detail": "Dispatch the stable workflow on pushed origin/main: builds Windows/macOS MCP runtimes and publishes CDN, npm and matching VSIX. Requires gh auth login and configured release secrets. Task completion means dispatched, not published.",
      "type": "process",
      "command": "gh",
      "args": [
        "workflow", "run", "keepwork-stable.yml",
        "--repo", "LiXizhi/keepworkExtension",
        "--ref", "main"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "keepwork VS code extension:Run",
      "type": "shell",
      "command": "code",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-extension"
      ],
      "dependsOn": "VS Code Extension: Build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "npm run compile:only",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": "$tsc",
      "label": "VS Code Extension: Build",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "command": "npm run watch",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": [],
      "label": "VS Code Extension: Watch",
      "isBackground": true,
      "group": "build"
    },
    {
      "type": "shell",
      "command": "npm run package",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": [],
      "label": "VS Code Extension: Package VSIX",
      "group": "build"
    },
    {
      "type": "shell",
      "label": "Keepwork: Publish Latest VSIX (Entra)",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}/scripts/publish-marketplace.ps1'"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "shell",
      "command": "npm run dev:server",
      "options": {
        "cwd": "${workspaceFolder}/apps/vscode-extension"
      },
      "problemMatcher": [],
      "label": "Keepwork MCP: Dev Server (8089)",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "keepwork Desktop: Start",
      "detail": "Restart the previous task, rebuild Desktop and MCP, and launch the fresh local bundle.",
      "type": "shell",
      "command": "npm",
      "args": [
        "start"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/aichat-desktop",
        "env": {
          "AICHAT_DESKTOP_LOCAL_SOURCE": "1",
          "AICHAT_DESKTOP_REPLACE": "1"
        }
      },
      "runOptions": { "instanceLimit": 1, "instancePolicy": "terminateOldest" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "type": "shell",
      "command": "node",
      "args": ["apps/mcp-rust/scripts/dev-server.cjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Keepwork MCP (Rust): Dev Server (8089)",
      "detail": "Stop existing daemon on 8089 and run the Rust MCP server in development mode (cargo run).",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "type": "shell",
      "command": "node",
      "args": ["apps/aichat-rust/scripts/bundle-mcp-rust.cjs"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Keepwork MCP (Rust): Build & Bundle",
      "detail": "Build release binary for keepwork-mcp and stage it into apps/aichat-rust/src-tauri/resources/mcp-runtime.",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "type": "shell",
      "command": "npm",
      "args": ["run", "test:contract"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "label": "Keepwork MCP (Rust): Contract Tests",
      "detail": "Run dual-engine wire compatibility contract tests against Node and Rust daemons.",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "keepwork Rust Desktop: Start",
      "detail": "Prepare the complete Node MCP runtime, then launch the Rust/Tauri desktop with local AIChat source. For the limited Rust MCP preview use pnpm dev:rust.",
      "type": "shell",
      "command": "pnpm",
      "args": ["tauri", "dev"],
      "options": {
        "cwd": "${workspaceFolder}/apps/aichat-rust",
        "env": {
          "AICHAT_DESKTOP_LOCAL_SOURCE": "1",
          "AICHAT_DESKTOP_REPLACE": "1",
          "RUST_BACKTRACE": "1"
        }
      },
      "runOptions": { "instanceLimit": 1, "instancePolicy": "terminateOldest" },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "keepwork Desktop: Build",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}/apps/aichat-desktop"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
