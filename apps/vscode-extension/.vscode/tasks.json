{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "keepwork VS code extension:Run",
      "type": "shell",
      "command": "code",
      "args": [
        "--new-window",
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "dependsOn": "VS Code Extension: Build",
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "npm run compile:only",
      "problemMatcher": "$tsc",
      "label": "VS Code Extension: Build",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "shell",
      "command": "npm run watch",
      "problemMatcher": [],
      "label": "VS Code Extension: Watch",
      "isBackground": true,
      "group": "build"
    },
    {
      "type": "shell",
      "command": "npm run package",
      "problemMatcher": [],
      "label": "VS Code Extension: Package VSIX",
      "group": "build"
    },
    {
      "type": "shell",
      "label": "Keepwork: Publish Latest VSIX (Entra)",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "& '${workspaceFolder}/../../scripts/publish-marketplace.ps1'"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "shell",
      "command": "npm run dev:server",
      "problemMatcher": [],
      "label": "Keepwork MCP: Dev Server (8089)",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
