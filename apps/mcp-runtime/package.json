{
  "name": "keepwork-mcp-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Keepwork MCP runtime",
  "license": "MIT",
  "bin": {
    "keepwork-mcp-runtime": "./dist/cli.cjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "stage": "npm run typecheck && npm run build && node scripts/stage-runtime.cjs",
    "make": "npm run stage && node scripts/package-runtime.cjs",
    "smoke": "node scripts/smoke-runtime.cjs",
    "manifest": "node scripts/generate-release-manifest.cjs",
    "test": "node --test scripts/check-release-version.test.cjs scripts/generate-release-manifest.test.cjs scripts/publish-qiniu-release.test.cjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "playwright-core": "1.57.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "extract-zip": "2.0.1",
    "tar": "7.5.22",
    "typescript": "^5.3.0"
  }
}
