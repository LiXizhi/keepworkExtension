{
  "schemaVersion": 1,
  "product": "keepwork-cef-host",
  "hostProtocol": 1,
  "serviceLauncher": 1,
  "maintenance": 1,
  "remoteVoice": { "version": 1, "entry": "keepwork-remote-voice.exe", "minWindows": [10, 0, 15063] },
  "hostVersion": "@KEEPWORK_HOST_VERSION@",
  "cefVersion": "@KEEPWORK_CEF_VERSION@",
  "cefMajor": @KEEPWORK_CEF_MAJOR@,
  "arch": "@KEEPWORK_HOST_ARCH@",
  "sandbox": "@KEEPWORK_SANDBOX@",
  "desktopBridge": false
}
