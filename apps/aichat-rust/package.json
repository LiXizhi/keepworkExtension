{
  "name": "keepwork-aichat-rust",
  "version": "0.2.10",
  "private": true,
  "description": "Rust + Tauri 2 native desktop application for KeepWork 第二大脑 (AIChat Desktop)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/build.mjs && cargo test --manifest-path src-tauri/Cargo.toml --features dev-bins && node --test tests/*.test.cjs",
    "test": "node --test tests/*.test.cjs",
    "smoke": "node scripts/smoke.cjs",
    "tauri": "tauri",
    "make:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "make:win:x64": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "make:win:arm64": "tauri build --target aarch64-pc-windows-msvc --bundles nsis"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
