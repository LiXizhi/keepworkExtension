{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for KeepWork 第二大脑 main, pet, and updates windows",
  "windows": ["main", "pet", "updates"],
  "remote": {
    "urls": [
      "https://keepwork.com/chat",
      "https://keepwork.com/chat/*",
      "https://keepwork.com/chat*",
      "https://keepwork.com/*",
      "https://cdn.keepwork.com",
      "https://cdn.keepwork.com/*",
      "http://127.0.0.1:*",
      "http://127.0.0.1:*/*",
      "http://localhost:*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "allow-desktop-commands",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "notification:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image"
  ]
}
